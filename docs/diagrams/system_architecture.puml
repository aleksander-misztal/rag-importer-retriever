@startuml system_architecture
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title RAG Evaluation System — Architektura (C4 Container)

Person(user, "Researcher", "Uploaduje dokumenty,\ntaskuje zapytania,\nuruchamia ewaluację")

System_Boundary(docker, "Docker Compose") {

    Container(streamlit, "Streamlit Web App", "Python / Streamlit", "Interfejs użytkownika:\nImporter (upload PDF)\nRetriever (chat RAG)")

    Container(pgvector, "PostgreSQL + PGVector", "PostgreSQL 16", "Baza wektorowa.\nPrzechowuje chunki\ni ich embeddingi")

    Container(eval, "Eval Runner", "Python Script", "Uruchamia pipeline\ndla każdego pytania.\nZbiera metryki,\nwywołuje LLM judge.")
}

System_Ext(openai, "OpenAI API", "Embeddingi: text-embedding-3-small\nPipeline LLM: gpt-4o-mini\nLLM Judge: gpt-4o")

Rel(user, streamlit, "Używa", "HTTPS / localhost")
Rel(streamlit, pgvector, "Zapisuje i odpytuje\nwektory", "psycopg2")
Rel(streamlit, openai, "Embeddingi + generacja\nodpowiedzi", "HTTPS / REST")
Rel(eval, streamlit, "Wywołuje pipeline\nRAG", "Python import")
Rel(eval, pgvector, "Odpytuje wektory\npodczas ewaluacji", "psycopg2")
Rel(eval, openai, "LLM judge:\nocena odpowiedzi", "HTTPS / REST")

@enduml
