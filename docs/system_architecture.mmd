graph LR
    Researcher([Researcher])

    subgraph System[System]
        subgraph Docker[Docker Compose]
            subgraph rag_app[rag_app]
                Streamlit["Streamlit\nWeb App"]
                Importer[Importer]
                Retriever["Retriever\nRAG Pipeline"]
                EvalRunner[Eval Runner]
            end
            subgraph rag_db[rag_db]
                PG[("PostgreSQL\n+ PGVector")]
            end
        end
        subgraph ext[External]
            OpenAI["OpenAI API\nembeddings / LLM / judge"]
        end
    end

    Researcher -->|HTTP| Streamlit
    Streamlit -->|upload PDF| Importer
    Streamlit -->|query| Retriever
    EvalRunner -->|invoke| Retriever

    Importer -->|store chunks| PG
    Retriever -->|vector search| PG

    Importer -->|text-embedding-3-small| OpenAI
    Retriever -->|gpt-4o-mini| OpenAI
    EvalRunner -->|judge gpt-4o| OpenAI
